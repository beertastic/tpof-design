{
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "MultiEdit",
      "Glob",
      "Grep",
      "Bash"
    ],
    "deny": [
      "Bash(git clean *)",
      "Bash(git reset --hard*)",
      "Bash(git push -f*)",
      "Bash(rm -rf *)",
      "Bash(sudo *)"
    ]
  }
}
