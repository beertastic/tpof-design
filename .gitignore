.DS_Store
Thumbs.db
*.tmp
*.bak
~$*
exports/
.claude/settings.local.json
.venv/
__pycache__/
*.pyc
.claude/*.tmp.*

# Generated board output — regenerable via tools/board-generator/generate.py
# Kept on disk (one current copy), never committed.
03-characters/*/renders/
03-characters/*/source/*.pptx
03-characters/*/source/*-Production-Boards.pdf

# Generated screenplay output — regenerable via tools/script-convert/render.py
# The .fountain file is the source and IS committed. So is the incoming typeset
# draft it was converted from, because that is what the writer actually sent.
02-story/scenes/the-price-of-freedom-*.pdf
02-story/scenes/the-price-of-freedom-*.fdx
02-story/scenes/the-price-of-freedom-*.html

# Build/patch archives
*.zip

# Rendered scene drafts — regenerable from the .fountain beside them
02-story/scenes/drafts/*.pdf
02-story/scenes/drafts/*.fdx
