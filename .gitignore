.DS_Store
Thumbs.db
*.tmp
*.bak
~$*
exports/
.claude/settings.local.json
.venv/
__pycache__/
*.pyc
.claude/*.tmp.*

# Staged reference attachments — copies of images that already live in this
# repository, gathered per outfit so the operator drags one folder in rather
# than hunting five files across three directories. Regenerable via
# tools/prompt-splitter/short.py; 8.6 MB of duplicated binaries per outfit,
# rewritten on every run. Same reasoning as renders/ below: kept on disk, one
# current copy, never committed. MANIFEST.txt goes with them — it is generated
# too, and is worthless without the images it describes.
03-characters/*/prompts/attach/

# The same thing for the hand-written evolution prompts, staged per pass by
# tools/stage-evolution-attachments. Copies of images that already live in this
# repository, so never committed — but note these have no other generator, and
# the script reads each prompt's own URL block to rebuild them. Run it after a
# fresh clone, or the folders will not exist.
03-characters/*/evolution/attachments/
08-species/*/evolution/attachments/

# Generated board output — regenerable via tools/board-generator/generate.py
# Kept on disk (one current copy), never committed.
03-characters/*/renders/
03-characters/*/source/*.pptx
03-characters/*/source/*-Production-Boards.pdf

# Generated screenplay output — regenerable via tools/script-convert/render.py
# The .fountain file is the source and IS committed. So is the incoming typeset
# draft it was converted from, because that is what the writer actually sent.
02-story/scenes/the-price-of-freedom-*.pdf
02-story/scenes/the-price-of-freedom-*.fdx
02-story/scenes/the-price-of-freedom-*.html

# Build/patch archives
*.zip

# Rendered scene drafts — regenerable from the .fountain beside them
02-story/scenes/drafts/*.pdf
02-story/scenes/drafts/*.fdx

# Study material — copyrighted stills from other productions, kept for reference
# and NEVER committed. This repository is public: an unauthenticated raw fetch
# returns 200. See 10-assets/study/README.md
10-assets/study/*
!10-assets/study/README.md
