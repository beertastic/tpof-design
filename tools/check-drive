#!/usr/bin/env bash
#
# The daily check: does Google Drive still match the repository?
#
#   ./tools/check-drive            # report drift, exit 1 if any
#   ./tools/check-drive shada      # one character
#
# READ-ONLY. It never writes to Drive, because the fix always needs a person to
# have decided the repository is right. When it reports drift, the fix is:
#
#   ./tools/publish-to-drive --go
#
# TO RUN IT DAILY, once rclone is set up (no sudo, no root):
#
#   crontab -e
#   17 9 * * *  /home/tris/tpof-design/tools/check-drive >/dev/null 2>&1
#
# It appends to ~/.local/state/tpof/drive-check.log either way, and raises a
# desktop notification when something has drifted, so a silent cron job that
# nobody reads still reaches you on the day it matters.
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1

LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/tpof"
LOG="$LOG_DIR/drive-check.log"
mkdir -p "$LOG_DIR"

out=$(./tools/publish-to-drive --check "$@" 2>&1)
rc=$?

{
    printf '\n===== %s =====\n' "$(date -u '+%Y-%m-%d %H:%M UTC')"
    printf '%s\n' "$out"
} >> "$LOG"

printf '%s\n' "$out"

if [ "$rc" -ne 0 ]; then
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -u critical "TPOF — Drive has drifted" \
            "Google Drive no longer matches the repository. Run tools/publish-to-drive --go" 2>/dev/null
    fi
    printf '\nLogged to %s\n' "$LOG"
fi

exit "$rc"
