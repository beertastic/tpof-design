#!/usr/bin/env bash
#
# The daily check: does Google Drive still match the repository?
#
#   ./tools/check-drive            # report drift, exit 1 if any
#   ./tools/check-drive shada      # one character
#
# READ-ONLY. It never writes to Drive, because the fix always needs a person to
# have decided the repository is right. It now reports two different things and
# they have two different fixes:
#
#   DRIFT    — the repo has files Drive lacks, or their bytes differ.
#              Fix: ./tools/publish-to-drive --go
#
#   UNKNOWN  — a file at a character's folder root that the repo does not have.
#              Publishing deletes nothing, so --go will NOT clear these and no
#              flag will. Look at it and, if it is superseded, delete it in
#              Drive by hand. Until then this keeps reporting, by design.
#
# TO RUN IT DAILY, once rclone is set up (no sudo, no root):
#
#   crontab -e
#   17 9 * * *  /home/tris/tpof-design/tools/check-drive >/dev/null 2>&1
#
# It appends to ~/.local/state/tpof/drive-check.log either way, and raises a
# desktop notification when something has drifted, so a silent cron job that
# nobody reads still reaches you on the day it matters.
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1

LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/tpof"
LOG="$LOG_DIR/drive-check.log"
mkdir -p "$LOG_DIR"

out=$(./tools/publish-to-drive --check "$@" 2>&1)
rc=$?

{
    printf '\n===== %s =====\n' "$(date -u '+%Y-%m-%d %H:%M UTC')"
    printf '%s\n' "$out"
} >> "$LOG"

printf '%s\n' "$out"

if [ "$rc" -ne 0 ]; then
    # cron gives you no session bus and no DISPLAY, so notify-send from here
    # fails silently -- which would make this whole notification a decoration.
    # The user bus is at a known path; point at it when the environment has not.
    [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] || \
        export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"
    [ -n "${DISPLAY:-}" ] || export DISPLAY=:0

    if command -v notify-send >/dev/null 2>&1; then
        notify-send -u critical "TPOF — Drive needs a look" \
            "Drive does not match the repository, or holds a file the repo does not. See ~/.local/state/tpof/drive-check.log" 2>/dev/null \
            || printf 'NOTE: could not raise a desktop notification.\n'
    fi
    printf '\nLogged to %s\n' "$LOG"
fi

exit "$rc"
