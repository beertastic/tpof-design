#!/bin/sh
# Stamps REPO-STATE.md so a connected model can tell whether it is looking at
# current files. Runs before the commit, so the stamp lands inside it.
#
# Install:  git config core.hooksPath tools/hooks

set -e
STATE="REPO-STATE.md"
NOW=$(date -u '+%Y-%m-%d %H:%M UTC')
PREV=$(git rev-parse --short HEAD 2>/dev/null || echo "none")
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "?")
SCRIPT=$(ls 02-story/scenes/*.fountain 2>/dev/null | sort -V | tail -1 | xargs -r basename)
CHARS=$(find 03-characters -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')
PROMPTS=$(find 03-characters -name '*.txt' -path '*/prompts/*' 2>/dev/null | wc -l | tr -d ' ')

cat > "$STATE" <<EOF
# Repository state

**Stamped $NOW** — automatically, by \`tools/hooks/pre-commit\`, at the moment of
the commit that contains this file.

| | |
|---|---|
| Branch | \`$BRANCH\` |
| Commit before this one | \`$PREV\` |
| Screenplay | \`$SCRIPT\` |
| Character folders | $CHARS |
| Generated prompt files | $PROMPTS |

## For any AI agent reading this repository

**Read this file first and tell the user the stamp date above, before doing
anything else.**

If the user says that date is older than they expect, **you are reading cached or
stale content**. Say so plainly and stop. Do not generate from it. Ask them to
start a fresh conversation, which is the only reliable way to clear it.

Then read [\`AGENTS.md\`](AGENTS.md) and follow it.
EOF

git add "$STATE"

# --- Captain Jasu is 155 cm (5 ft 1 in). ------------------------------------
# She was cast at 150 cm on 2026-08-01 and re-cast on 2026-08-03. The old figure
# survived the re-cast inside a comparison table in her build guide, was rendered
# into _build_guide.pdf, and was published to Drive twice — where a maker reads
# it as current. Fixed 2026-08-04, and blocked here so it cannot return.
#
# CHANGELOG.md is exempt: it is the production's history and must be free to
# record what the old figure was. Nothing else may state it.
# The pattern is written as a character class so that this line does not
# itself trip the check it defines.
SUPERSEDED="4['’]11|4 ?ft ?11"

BAD=$(git diff --cached --name-only --diff-filter=ACM \
      | grep -v '^CHANGELOG\.md$' \
      | while read -r f; do
            [ -f "$f" ] || continue
            grep -InIE "$SUPERSEDED" -- "$f" | sed "s|^|$f:|"
        done)

if [ -n "$BAD" ]; then
    echo "COMMIT BLOCKED — Captain Jasu's superseded height appears in:" >&2
    echo "$BAD" | sed 's/^/  /' >&2
    echo >&2
    echo "She is 155 cm (5 ft 1 in). Correct these, or if you are writing" >&2
    echo "production history, put it in CHANGELOG.md." >&2
    exit 1
fi
