#!/usr/bin/env bash
#
# Publish signed-off character work to the production Google Drive.
#
#   ./tools/publish-to-drive              # dry run — shows what WOULD change
#   ./tools/publish-to-drive --go         # actually sync
#   ./tools/publish-to-drive --check      # read-only drift report, exit 1 on drift
#   ./tools/publish-to-drive shada --go   # one character
#
# WHAT GOES, per approved character — ONE FLAT FOLDER, no subfolders:
#
#   _build_guide.pdf           what a maker works from — READ IT FIRST
#   _print_list.pdf            what we make and print: sizes, colours, swatches
#   _shopping_list.pdf         what we buy secondhand: search terms and budget
#   _published-from-repo.txt   provenance: the commit, the files, their sizes
#   _*-board.pdf               the finished boards
#   turn-*.png                 the build plates
#   *.png                      every other generated image
#
# NO MARKDOWN. Drive does not render it — it shows the raw source, hashes and
# pipe tables and all, which is not a thing to hand a maker. `_build_guide.md`
# is the repository's source and `_build_guide.pdf` is what ships; build it
# with ./tools/build-guide-pdf. Boards carry a `_` for the same reason the
# guide does: to sort above the images rather than into the middle of them.
#
# FLAT IS THE STANDARD, decided 2026-08-04, and it applies to every character
# added from now on. The costume department browses Drive by opening one image
# and arrowing left and right through the set. Subfolders broke that — the
# turnarounds, the artwork and the boards each had to be opened separately, and
# nobody browses a costume that way. The two meta files carry a `_` prefix so
# they sort above the images and stay out of the scroll.
#
# THE REPOSITORY IS THE SOURCE OF TRUTH. This is a one-way push: every file the
# repo has is written to the character's folder root, overwriting what is there.
#
# IT DELETES NOTHING, ANYWHERE — decided 2026-08-11. `rclone copy`, not `sync`.
# A file at the root that the repository does not have is REPORTED, on every
# run and in every mode, and left where it is.
#
# That is a real trade and worth naming. The failure this tool exists to prevent
# is the costume department building from a superseded image, and a stale plate
# left beside a current one is exactly how that happens — so the guarantee is
# now "you will be told", not "it cannot be there". A destructive tool that is
# ever wrong about what is disposable costs more than a nagging one: the whole
# reason this note exists is 66 files that a `sync` would have taken.
#
# The report is therefore not decoration. It repeats until a person deletes the
# file in Drive, and there is deliberately no flag to make it stop.
#
# SUBFOLDERS ARE NOT OURS AND ARE NEVER TOUCHED — decided 2026-08-11. The root
# is the published set; anything one level down belongs to whoever put it there.
# Reference photographs, fitting shots, footage from the day: they live in a
# subfolder and survive every publish, including the deletions.
#
# The line is drawn at depth, not at name, because a name-based ignore list is
# one more thing to keep in step with Drive — and the day it falls behind it
# deletes somebody's only copy of something. Depth needs no maintenance: make a
# folder, it is yours. See `--exclude /*/**` where RO_FLAGS is built.
#
# SO THE ROOT IS WRITTEN, NOT OWNED. The repo's files always win on their own
# names; everything else at the root is reported and kept. Subfolders are not
# even looked at.
#
# ONE NAMESPACE. Flat means turnarounds, artwork and boards share a filename
# space. The script refuses to publish a character with duplicate basenames
# rather than let one file silently overwrite another.
#
# WHY rclone AND NOT THE DRIVE CONNECTOR. The connector Claude uses can create
# files but cannot update or delete them, so re-publishing through it leaves two
# files with the same name and different contents. It also has to carry image
# bytes inline, which is impractical at ~2 MB a plate. rclone does a real sync.
#
# ONE-TIME SETUP
#
#   1. Install rclone:            sudo apt install rclone     (or brew install rclone)
#   2. Configure a Drive remote:  rclone config
#        - new remote, name it exactly:  tpof
#        - storage: drive
#        - scope: 1 (full access) — 'drive.file' will NOT see the existing
#          folder, because it was not created by rclone
#        - accept the browser auth prompt
#   3. Check it:                  rclone lsd tpof:
#
# The Drive account is info@tristanpretty.com, which is NOT the Claude account.
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1

# Costume / Wardrobe, inside the Price of Freedom folder. Each character gets a
# subfolder of this, named for the character.
DRIVE_PARENT="1twIFwScVQhGSgHpTfmPieEMA5jjU5g8T"
REMOTE="tpof"

# THE DRIVE FOLDER NAMES ARE NOT THE REPO SLUGS. People made those folders
# before this script existed and named them by hand — captain-jasu lives in a
# folder called "Jasu". Deriving the name would be a guess, and a wrong guess
# does not fail: it quietly creates a SECOND folder for the same character,
# which is the exact duplicate this tool exists to prevent. So the mapping is
# explicit, and a character that is not in it is an error, not a new folder.
#
# Baylan added 2026-08-11. He is the first character published with NO existing
# Drive folder — Jasu, Nyx, Shada and Vala were all made by hand before this
# script — so `Baylan` is created by the first publish rather than matched to
# something. That is safe here precisely because there was nothing to collide
# with: the danger this mapping guards against is a SECOND folder for a
# character who already has one under a different name, and a check of the
# parent folder confirmed he had none. Anyone added later gets the same check
# first — read the folder list the script prints, then map to what is there.
drive_folder() {
    case "$1" in
        captain-jasu) printf 'Jasu' ;;
        shada)        printf 'Shada' ;;
        baylan)       printf 'Baylan' ;;
        *)            printf '' ;;
    esac
}

# HOLDING A FILE BACK. `do-not-publish.txt` in a character's folder names files
# that exist on disk but must not reach Drive — one filename per line, `#` for
# comments. It is for artwork that is known wrong and waiting on a re-roll:
# publishing those is the precise failure this tool exists to prevent, and a
# failed plate on disk is indistinguishable from a good one to rclone.
#
# Added 2026-08-04, after Jasu finished four re-rolls behind her prompts. Held
# files are reported on every run and counted in the summary, so a hold cannot
# quietly become permanent.
held() {
    local holdfile="$1" name="$2"
    [ -f "$holdfile" ] || return 1
    sed 's/#.*//' "$holdfile" 2>/dev/null | grep -qx "[[:space:]]*${name}[[:space:]]*"
}

# Colour only for a human at a terminal — this runs from cron, and escape codes
# in a log file are noise nobody reads twice.
if [ -t 1 ]; then
    C_B=$'\033[1m'; C_R=$'\033[31m'; C_G=$'\033[32m'; C_Y=$'\033[33m'; C_0=$'\033[0m'
else
    C_B=''; C_R=''; C_G=''; C_Y=''; C_0=''
fi
b() { printf '%s%s%s\n' "$C_B" "$*" "$C_0"; }
ok() { printf '  %s✓%s %s\n' "$C_G" "$C_0" "$*"; }
no() { printf '  %s✗%s %s\n' "$C_R" "$C_0" "$*"; }
warn() { printf '  %s!%s %s\n' "$C_Y" "$C_0" "$*"; }
# Defined up here with the other helpers because publish_flat() needs it, and a
# function defined below the main loop does not exist yet when the loop runs.
plural() { [ "$1" -eq 1 ] && printf '%s %s' "$1" "$2" || printf '%s %s' "$1" "$3"; }

MODE="dry"; ONLY=""
for a in "$@"; do
    case "$a" in
        --go) MODE="go" ;;
        --check) MODE="check" ;;
        -*) no "unknown flag: $a"; exit 1 ;;
        *) ONLY="$a" ;;
    esac
done

if ! command -v rclone >/dev/null 2>&1; then
    no "rclone is not installed — see the setup notes at the top of this script."
    echo "     sudo apt install rclone && rclone config"
    exit 1
fi
if ! rclone listremotes 2>/dev/null | grep -qx "${REMOTE}:"; then
    no "no rclone remote called '${REMOTE}'. Run: rclone config"
    exit 1
fi

# A remote can exist and still have no OAuth token — quitting rclone config
# before the browser round-trip finishes leaves exactly that. Reaching Drive
# once, here, turns what would be the same error repeated per set into one
# instruction, and proves the folder id resolves before anything is written.
PREFLIGHT=$(rclone lsd "${REMOTE}:" --drive-root-folder-id "$DRIVE_PARENT" 2>&1)
if [ $? -ne 0 ]; then
    no "cannot reach Drive."
    sed 's/^/     /' <<<"$PREFLIGHT"
    case "$PREFLIGHT" in
        *"empty token"*|*"token expired"*|*oauth*)
            echo
            echo "     The remote exists but was never authorised — rclone config was quit"
            echo "     before the browser step finished. Reconnect and sign in as"
            echo "     info@tristanpretty.com:"
            echo
            echo "         rclone config reconnect ${REMOTE}:"
            ;;
    esac
    exit 1
fi

# --log-level ERROR keeps rclone's shared-client_id deprecation notice out of
# every set's output. It is real and dated — see Drive-Publishing.md — but five
# copies per run is how a warning stops being read.
#
# `--exclude /*/**` IS THE SUBFOLDER ESCAPE HATCH, restored 2026-08-11. It
# excludes everything below the first level, so the sync sees and manages only
# the loose files at the character's folder root. Subfolders belong to whoever
# made them: reference photographs, fitting shots, footage from the day. rclone
# never deletes what a filter excluded, so they survive every publish untouched.
#
# WHY IT IS A FILTER AND NOT --max-depth. Both would stop the descent, but only
# an exclude carries rclone's guarantee that filtered destination files are left
# alone rather than treated as absent from the source and deleted. The
# difference is the whole point here, so it is spelled as a filter.
RO_FLAGS=(--drive-root-folder-id "$DRIVE_PARENT" --exclude ".*" --exclude "/*/**" --log-level ERROR)

# --checksum COMPARES MD5, NOT SIZE-AND-MODTIME, and it is load-bearing here.
#
# Staging copies files into a mktemp dir, so every staged file carries today's
# mtime whatever its contents. rclone's default comparison would then read all
# ~60 as changed and re-upload them every publish — and, worse, would skip a
# file whose bytes changed but whose SIZE did not and whose mtime landed inside
# the modify window. A re-rolled plate that happens to match its predecessor's
# byte count is exactly that case, and it would have been silently kept stale.
#
# Caught by a local test on 2026-08-11: a 3-byte "OLD" survived a copy from a
# 3-byte "NEW". With hashes it transfers, and unchanged files are skipped.
RC_FLAGS=("${RO_FLAGS[@]}" --checksum)
[ "$MODE" = "dry" ] && RC_FLAGS+=(--dry-run)

echo
case "$MODE" in
    dry)   b "DRY RUN — nothing will be changed. Add --go to publish." ;;
    go)    b "PUBLISHING — the repository's files are written over Drive's. Nothing is deleted." ;;
    check) b "CHECKING — read-only. Nothing on Drive will be touched." ;;
esac

b "Costume / Wardrobe — the folders currently on Drive:"
# Keep only real lsd rows. Notices go to the same stream and start with a date,
# so they survive a leading-digit test — match on the NOTICE tag instead.
grep -v 'NOTICE' <<<"$PREFLIGHT" | grep -E '^ *-?[0-9]' | awk '{$1=$1};1' | cut -d' ' -f5- | sed 's/^/    /'

# The manifest is a pure function of the repository content: the commit that
# last touched these exact files, and their names and sizes. No wall-clock
# stamp, deliberately — that keeps it byte-stable, so --check can compare it
# like any other file instead of reporting false drift on every run.
manifest() {
    local char="$1" set_name="$2" src="$3"; shift 3
    local rev
    rev=$(git log -1 --format='%h  %cs' -- "$@" 2>/dev/null)
    [ -n "$rev" ] || rev="(uncommitted)"
    printf 'Published from the repository by tools/publish-to-drive.\n'
    printf 'DO NOT EDIT THESE HERE. The repository is the source of truth and the\n'
    printf 'loose files in this folder are overwritten on every publish, including\n'
    printf 'deletions. Subfolders are never touched — anything you want to keep on\n'
    printf 'Drive, put in a subfolder.\n\n'
    printf 'character   : %s\n' "$char"
    printf 'set         : %s\n' "$set_name"
    printf 'source      : %s\n' "$src"
    printf 'last change : %s\n\n' "$rev"
    printf 'files:\n'
    local f
    for f in "$@"; do
        printf '  %10s  %s\n' "$(stat -c%s "$f")" "$(basename "$f")"
    done
}

DRIFT=0; SYNCED=0; SKIPPED=0; HELD_TOTAL=0; UNKNOWN_TOTAL=0
# Stage every file for one character and make their Drive folder match.
#
# FLAT, DELIBERATELY — decided 2026-08-04. One folder per character with every
# image loose in it, so the costume department can open any plate in Drive's
# previewer and arrow left and right through the whole set. Subfolders broke
# that: turnarounds, artwork and boards each had to be opened separately, and
# nobody browses a costume that way.
#
# The two meta files are prefixed `_` so they sort above the images and stay out
# of the way of the scroll.
publish_flat() {
    local folder="$1" char="$2" dir="$3"; shift 3
    local n=$#
    if [ "$n" -eq 0 ]; then
        printf '    %-12s —\n' "nothing"
        return 0
    fi

    # A flat folder has one namespace, so two files that were fine in separate
    # subfolders now silently overwrite each other. Refuse rather than publish
    # half a costume.
    local dupes
    dupes=$(for f in "$@"; do basename "$f"; done | sort | uniq -d)
    if [ -n "$dupes" ]; then
        no "$char — duplicate filenames, cannot publish flat:"
        sed 's/^/        /' <<<"$dupes"
        return 1
    fi

    local stage; stage=$(mktemp -d)
    if ! cp "$@" "$stage/"; then
        rm -rf "$stage"; no "$folder — could not stage"; return 1
    fi
    manifest "$char" "everything" "$dir" "$@" > "$stage/_published-from-repo.txt"

    local dest="${REMOTE}:${folder}"
    local rc=0
    local sub="files"

    # WHAT IS ALREADY THERE. One listing, read by every mode. `--combined` gives
    # a line per file:
    #   -  only on Drive     UNKNOWN — not ours. Never deleted, always reported
    #   +  only in the repo   not yet published
    #   *  in both, different bytes
    local out unknown fresh differ
    out=$(rclone check "$stage" "$dest" --combined - "${RO_FLAGS[@]}" 2>/dev/null)
    if [ -z "$out" ]; then
        # No listing at all means the folder does not exist yet — a character's
        # first publish. Everything staged is new and nothing can be unknown.
        out=$(cd "$stage" && for f in *; do printf '+ %s\n' "$f"; done)
    fi
    unknown=$(grep -c '^- ' <<<"$out")
    fresh=$(grep -c '^+ ' <<<"$out")
    differ=$(grep -c '^\* ' <<<"$out")

    if [ "$MODE" = "check" ]; then
        if [ "$((unknown + fresh + differ))" -eq 0 ]; then
            printf '    %-12s %s files, up to date\n' "$sub" "$n"
        else
            [ "$((fresh + differ))" -gt 0 ] && DRIFT=$((DRIFT + 1))
            printf '    %s%-12s DRIFT%s — %s not published, %s differ, %s unknown\n' \
                "$C_R" "$sub" "$C_0" "$fresh" "$differ" "$unknown"
            # `-` lines are listed by the alert below, not here, so an unknown
            # file is reported once and with the explanation attached.
            grep -E '^[+*] ' <<<"$out" | sed 's/^/        /'
        fi
    else
        # `copy`, NOT `sync` — decided 2026-08-11. copy adds and overwrites and
        # never removes, so a file on Drive that the repository does not have
        # survives the publish and is reported instead. See the note below.
        rclone copy "$stage" "$dest" "${RC_FLAGS[@]}" 2>&1 | sed 's/^/        /' | tail -4
        rc=${PIPESTATUS[0]}
        if [ "$rc" -eq 0 ]; then
            printf '    %-12s %s files\n' "$sub" "$n"
        else
            no "$folder/$sub — rclone exited $rc"
        fi
    fi

    # THE ALERT. Nothing deletes these now, so this line is the whole of the
    # defence: it is the only thing between a superseded plate at the root and
    # somebody building from it. Printed in every mode, including after a
    # publish that otherwise succeeded, and counted into the exit status.
    if [ "$unknown" -gt 0 ]; then
        UNKNOWN_TOTAL=$((UNKNOWN_TOTAL + unknown))
        warn "$folder — $(plural "$unknown" "file" "files") on Drive that the repository does not have:"
        grep '^- ' <<<"$out" | sed 's/^- /        /'
        printf '        NOT deleted. If superseded, delete by hand in Drive.\n'
    fi

    rm -rf "$stage"
    return "$rc"
}

# check_shadows() lived here until 2026-08-04, and the flat layout retired it.
#
# It existed because the sync wrote into subfolders and could not reach the
# character's folder root, so a superseded file left loose up there survived
# every publish. That was not hypothetical: on 2026-08-03 Jasu's root held the
# five superseded v1 turnarounds under the same names as the live ones, one
# level up. Two files, same name, different boots.
#
# Publishing flat makes the root the thing being synced, so rclone deletes
# anything there that is not in the repository. The failure mode is designed
# out rather than reported on, which is why the function and its
# --purge-shadows flag are gone.
#
# IT STAYS RETIRED, but what replaced it changed twice on 2026-08-11. The shadow
# bug needed the published set to sit a level BELOW a same-named file; the
# published set is now the root itself, so that geometry cannot recur. What can
# still happen is a superseded plate loose at the root under a name the repo no
# longer uses — and since nothing deletes any more, the reporting that
# check_shadows() did is back, in the alert at the end of publish_flat(). It is
# broader than the old function: it names every unknown root file, not only the
# ones that collide.
#
# THE COST, STATED PLAINLY, IN TWO PARTS:
#   - A superseded image parked in a SUBFOLDER is invisible to this tool
#     forever. Nothing will flag or remove it.
#   - A superseded image at the ROOT is flagged forever but never removed, so
#     the report is only as good as somebody reading it and acting in Drive.
# Both are the deliberate price of a tool that cannot destroy work. The thing
# being protected is a folder that also holds footage nothing here can regenerate.

for dir in 03-characters/*/ 08-species/*/; do
    dir="${dir%/}"
    char=$(basename "$dir")
    [ -n "$ONLY" ] && [ "$ONLY" != "$char" ] && continue
    [ -f "$dir/outfits.yaml" ] || continue

    # A character is publishable when an outfit is APPROVED. Approval is the
    # sign-off gate everywhere else in this repo; it is the gate here too.
    if ! grep -q "^    approved:" "$dir/outfits.yaml" 2>/dev/null; then
        warn "$char — no approved outfit, not published"
        SKIPPED=$((SKIPPED+1)); continue
    fi

    art="$dir/source/artwork"
    hold="$dir/do-not-publish.txt"
    turns=(); others=(); boards=(); nheld=0
    for f in "$art"/turn-*.png; do
        [ -f "$f" ] || continue
        held "$hold" "$(basename "$f")" && { warn "held back: $(basename "$f")"; nheld=$((nheld+1)); continue; }
        turns+=("$f")
    done
    for f in "$art"/*.png; do
        [ -f "$f" ] || continue
        case "$(basename "$f")" in turn-*) continue ;; esac
        held "$hold" "$(basename "$f")" && { warn "held back: $(basename "$f")"; nheld=$((nheld+1)); continue; }
        others+=("$f")
    done
    for f in "$dir"/*.pdf; do
        [ -f "$f" ] || continue
        held "$hold" "$(basename "$f")" && { warn "held back: $(basename "$f")"; nheld=$((nheld+1)); continue; }
        boards+=("$f")
    done
    HELD_TOTAL=$((HELD_TOTAL+nheld))

    # NO MARKDOWN GOES TO DRIVE. Drive does not render it — it shows the raw
    # source, hashes and pipe tables and all, which is not a thing to hand a
    # maker. `_build_guide.md` is the repository's source; `_build_guide.pdf`
    # is what gets published, and the *.pdf glob above already caught it.
    #
    # Character.md and Prompts.md are working documents for this repository and
    # never go at all — the reasoning in them is not what anybody needs at a
    # bench, and publishing them would invite edits away from the source.
    if [ -f "$dir/_build_guide.md" ] && [ ! -f "$dir/_build_guide.pdf" ]; then
        warn "$char — _build_guide.md has no PDF. Run: ./tools/build-guide-pdf $char"
    fi

    # The two list sheets are generated from outfits.yaml and the *.pdf glob
    # above publishes them like any board. If outfits.yaml is newer than the
    # PDF, Drive is about to receive a sheet that no longer matches the source
    # of truth — which is the failure the build guide already had once.
    if [ -f "$dir/outfits.yaml" ]; then
        for sheet in _print_list _shopping_list; do
            if [ ! -f "$dir/$sheet.pdf" ]; then
                grep -q '^      - item:' "$dir/outfits.yaml" 2>/dev/null &&
                    warn "$char — no $sheet.pdf. Run: ./tools/build-lists $char"
            elif [ "$dir/outfits.yaml" -nt "$dir/$sheet.pdf" ]; then
                warn "$char — outfits.yaml is NEWER than $sheet.pdf. Run: ./tools/build-lists $char"
            fi
        done
    fi

    if [ "${#turns[@]}" -eq 0 ] && [ "${#others[@]}" -eq 0 ] && [ "${#boards[@]}" -eq 0 ]; then
        warn "$char — approved but nothing on disk to publish"
        SKIPPED=$((SKIPPED+1)); continue
    fi

    folder=$(drive_folder "$char")
    if [ -z "$folder" ]; then
        no "$char — no Drive folder mapped. Add it to drive_folder() in this script,"
        echo "     using the EXACT name of their folder in the list above. Publishing"
        echo "     under a guessed name would create a second folder for them."
        SKIPPED=$((SKIPPED+1)); continue
    fi

    b "$char  →  $folder/"
    publish_flat "$folder" "$char" "$dir" \
        ${turns[@]+"${turns[@]}"} \
        ${others[@]+"${others[@]}"} \
        ${boards[@]+"${boards[@]}"}
    SYNCED=$((SYNCED+1))
done

echo

# A hold is a temporary state waiting on a re-roll, so say so every run. Silence
# is how four failed plates become four permanently missing ones.
[ "$HELD_TOTAL" -gt 0 ] && \
    warn "$(plural "$HELD_TOTAL" file files) held back by do-not-publish.txt — re-roll, then re-run"

# An unknown file outlives every publish now, so it is reported after one too.
# It is the same count either way; only the sentence that follows it differs,
# because after --go there is nothing left to try.
[ "$UNKNOWN_TOTAL" -gt 0 ] && \
    warn "$(plural "$UNKNOWN_TOTAL" file files) on Drive not in the repository — listed above, none deleted"

if [ "$MODE" = "check" ]; then
    if [ "$DRIFT" -eq 0 ] && [ "$UNKNOWN_TOTAL" -eq 0 ]; then
        ok "$(plural "$SYNCED" character characters) checked, $SKIPPED skipped — Drive matches the repository"
    else
        [ "$DRIFT" -gt 0 ] && {
            no "$(plural "$DRIFT" character characters) drifted"
            echo "  Fix with: ./tools/publish-to-drive --go   (the repository wins)"
        }
        # Deliberately NOT offered a command. Publishing cannot clear these and
        # there is no flag that will: deciding a file on Drive is finished with
        # is a person's call, made in Drive. This will keep reporting until then,
        # which is the intended nag rather than a fault.
        [ "$UNKNOWN_TOTAL" -gt 0 ] && \
            no "$(plural "$UNKNOWN_TOTAL" file files) unknown at a character's folder root — delete by hand in Drive if superseded"
        echo
        exit 1
    fi
else
    b "$(plural "$SYNCED" character characters), $SKIPPED skipped"
    [ "$MODE" = "go" ] || echo "  This was a dry run. Re-run with --go to apply."
fi
echo
