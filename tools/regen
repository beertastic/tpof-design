#!/usr/bin/env bash
#
# Regenerate one character's prompts, commit them, push them, and print exactly
# what to do next.
#
#   ./tools/regen baylan
#
# Written 2026-08-01 because "regenerate all three generators, commit, PUSH" is a
# description of a step, not a step. This is the step.
#
set -uo pipefail

cd "$(dirname "$0")/.." || exit 1
ROOT="$PWD"

b() { printf '\033[1m%s\033[0m\n' "$*"; }
ok() { printf '  \033[32m✓\033[0m %s\n' "$*"; }
no() { printf '  \033[31m✗\033[0m %s\n' "$*"; }
warn() { printf '  \033[33m!\033[0m %s\n' "$*"; }

CHAR="${1:-}"
if [ -z "$CHAR" ]; then
    b "Usage: ./tools/regen <character>"
    echo
    echo "Characters:"
    for d in 03-characters/*/; do
        [ -f "$d/outfits.yaml" ] && echo "  $(basename "$d")"
    done
    exit 1
fi

DIR="03-characters/$CHAR"
if [ ! -f "$DIR/outfits.yaml" ]; then
    # Species live elsewhere; try there before giving up.
    if [ -f "08-species/$CHAR/outfits.yaml" ]; then
        DIR="08-species/$CHAR"
    else
        no "No such character: $CHAR"
        echo "     Looked for $DIR/outfits.yaml"
        exit 1
    fi
fi

# shellcheck disable=SC1091
[ -f .venv/bin/activate ] && source .venv/bin/activate

echo
b "$CHAR — regenerating"

WARNINGS=""
for gen in short turnarounds split; do
    OUT=$(python "tools/prompt-splitter/$gen.py" "$CHAR" 2>&1)
    if [ $? -ne 0 ]; then
        no "$gen.py failed:"
        echo "$OUT" | sed 's/^/      /'
        exit 1
    fi
    ok "$gen.py — $(echo "$OUT" | grep -vE '^[[:space:]]*!' | tail -1)"
    WARNINGS="$WARNINGS$(echo "$OUT" | grep -E '^[[:space:]]*!' || true)
"
done

WARNINGS=$(echo "$WARNINGS" | sed 's/^[[:space:]]*//' | sort -u | grep -v '^$' || true)
# Match the two warnings that actually mean "not ready", not every warning that
# happens to mention them.
#
# FIXED 2026-08-05. This was `grep -E 'handedness|must_show'`, a substring test
# standing in for a condition. Baylan's approval run tripped it on a warning
# reading "description: puts the coat at the knee but must_show says the back" —
# a genuine contradiction inside working-coat, and nothing to do with either
# field being absent. The script then printed STOP, said "Handedness and
# must_show are not optional", and sent the operator to look for a missing field
# that was present and correct all along. The prompts had already generated,
# committed and pushed successfully.
#
# The real warnings are emitted by turnarounds.py and say "no `handedness:`
# declared" and "no `must_show:`". Anchor on those.
BLOCKING=$(echo "$WARNINGS" | grep -E 'no `handedness:`|no `must_show:`' || true)
if [ -n "$WARNINGS" ]; then
    echo
    b "Warnings"
    echo "$WARNINGS" | sed 's/^/  /'
fi

# ---- commit and push -------------------------------------------------------
echo
if [ -z "$(git status --porcelain)" ]; then
    ok "nothing changed — prompts were already current"
else
    # WARNING — THIS IS `git add -A`, NOT "add the prompts".
    #
    # It sweeps the WHOLE working tree into a commit titled "prompts(<char>):
    # regenerate". Anything else you had in flight goes in under that message and
    # its reasoning is lost from the log.
    #
    # It bit on 2026-08-05: three rounds of fixes to THIS SCRIPT, plus a
    # correction to APPROVAL.md, were committed and pushed as three separate
    # "prompts(baylan): regenerate" commits. The changes were right and the
    # record was wrong.
    #
    # SO: commit unrelated work BEFORE running regen. If you are editing tools
    # or documentation, commit that first, then regen. The reasoning that
    # survives is whatever you put in the files themselves.
    git add -A
    # An optional second argument is the commit message. Without it the message is
    # generic, which is right for a plain regeneration and wrong when the run also
    # carries a change worth explaining — regen would otherwise swallow the
    # reasoning into "regenerate" and leave nothing to commit afterwards.
    MSG="${2:-prompts($CHAR): regenerate}"
    if git commit -q -m "$MSG"; then
        ok "committed $(git rev-parse --short HEAD)"
    else
        no "commit failed"; exit 1
    fi
    if git push -q origin "$(git rev-parse --abbrev-ref HEAD)" 2>/dev/null; then
        ok "pushed"
    else
        no "PUSH FAILED — the reference photo URLs point at the pushed branch,"
        echo "     so generation will use stale files. Fix this before continuing:"
        echo "       git push"
        exit 1
    fi
fi

# ---- what to do next -------------------------------------------------------
#
# THE FIRST OUTFIT IN outfits.yaml IS THE PRIMARY ONE, and it is the front that
# has to be approved first — everything else matches against it.
#
# This used to be `ls turn-*-front.txt | head -1`, which is ALPHABETICAL, and
# alphabetical is not the same thing. Baylan is the first character with two
# outfits and it sent the operator at `working-coat` — his off-duty set, worn in
# eight scenes — instead of `working`, which his own file calls "his only
# costume" and lists in all twelve. Shada and Jasu have one outfit each, so
# nothing caught it until now.
PRIMARY=$(python - "$DIR/outfits.yaml" <<'PY' 2>/dev/null
import sys, yaml
try:
    d = yaml.safe_load(open(sys.argv[1], encoding="utf-8")) or {}
    print((d.get("outfits") or [{}])[0].get("id", ""))
except Exception:
    print("")
PY
)

FRONT=""
[ -n "$PRIMARY" ] && \
    FRONT=$(ls "$DIR/prompts/turnarounds-short/turn-$PRIMARY-front.txt" 2>/dev/null)
# Fall back to alphabetical only if the primary has no front prompt yet.
[ -z "$FRONT" ] && \
    FRONT=$(ls "$DIR"/prompts/turnarounds-short/turn-*-front.txt 2>/dev/null | head -1)
if [ -z "$FRONT" ]; then
    echo; warn "No front turnaround prompt found in $DIR/prompts/turnarounds-short/"
    exit 0
fi

STAMP=$(sed -n '4p' "$FRONT")
COMMIT=$(echo "$STAMP" | sed -n 's/.*repo commit \([0-9a-f]*\).*/\1/p')
HASH=$(echo "$STAMP" | sed -n 's/Prompt version: \([0-9a-f]*\).*/\1/p')
ACTOR=$(ls "$DIR"/reference/actor/*.jpg "$DIR"/reference/actor/*.png 2>/dev/null | head -3)

if [ -n "$BLOCKING" ]; then
    echo
    b "STOP — this character is not ready to generate"
    echo
    echo "  Handedness and must_show are not optional. Without them every weapon"
    echo "  and armour placement is decided by the generator, differently each"
    echo "  time, and no two views will match."
    echo
    echo "  Fix $DIR/outfits.yaml, then run this again."
    echo "  See 09-prompt-library/Handedness-And-Placement.md"
    echo
    exit 2
fi

OUTFIT=$(basename "$FRONT" .txt | sed 's/^turn-//; s/-front$//')

# ONCE A VIEW IS APPROVED, THE FRONT IS NOT THE NEXT STEP — the remaining views
# are. Added 2026-08-05, on the first approval run this script had ever seen:
# it congratulated the operator on locking the front and then told them to go
# and generate the front.
APPROVED_VIEW=$(python - "$DIR/outfits.yaml" "$OUTFIT" <<'PY' 2>/dev/null
import sys, yaml
try:
    d = yaml.safe_load(open(sys.argv[1], encoding="utf-8")) or {}
    o = next(x for x in (d.get("outfits") or []) if x.get("id") == sys.argv[2])
    print((o.get("approved") or {}).get("view", ""))
except Exception:
    print("")
PY
)

echo
if [ -n "$APPROVED_VIEW" ]; then
    b "NEXT — the remaining views ($OUTFIT $APPROVED_VIEW is LOCKED)"
    echo
    echo "  The $APPROVED_VIEW is approved and must NOT be regenerated. Every other"
    echo "  view now matches against it. Run them one at a time:"
    echo
    # `turn-working-*` also matches `turn-working-coat-*`, which is a DIFFERENT
    # outfit with its own views and its own attach folder. Ask python for the
    # views that belong to this outfit rather than globbing for them.
    VIEWS=$(python - "$DIR/outfits.yaml" "$OUTFIT" <<'PY' 2>/dev/null
import sys, yaml
d = yaml.safe_load(open(sys.argv[1], encoding="utf-8")) or {}
outfits = d.get("outfits") or []
o = next((x for x in outfits if x.get("id") == sys.argv[2]), {})
approved = (o.get("approved") or {}).get("view", "")
views = o.get("views") or ["front", "back", "left", "right", "natural"]
print(" ".join(v for v in views if v != approved))
PY
)
    for v in $VIEWS; do
        f="$DIR/prompts/turnarounds-short/turn-$OUTFIT-$v.txt"
        [ -f "$f" ] && printf '       \033[36m%s\033[0m\n' "$ROOT/${f#./}"
    done
    echo
    echo "  Fresh chat each time, tier High, paste the file as the first message."
else
    b "NEXT — the front turnaround"
    echo
    echo "  1. Open a FRESH ChatGPT chat. Set the tier to High."
    echo "  2. Paste this whole file as your first message, nothing else:"
    echo
    printf '       \033[36m%s\033[0m\n' "$ROOT/${FRONT#./}"
fi
echo
ATTACH="$DIR/prompts/attach/$OUTFIT"
if [ -d "$ATTACH" ]; then
    # -maxdepth 1: the per-slot folders under here are COMPLETE alternatives to
    # this one, not extras to add to it. Counting recursively told the operator
    # to attach "all 29" of Baylan's when the answer was five, and the extra 24
    # are slot references that must never reach a turnaround.
    NFILES=$(find "$ATTACH" -maxdepth 1 -type f ! -name MANIFEST.txt | wc -l)
    echo "  3. Attach EVERY image in this folder — all $NFILES of them:"
    echo
    printf '       \033[36m%s\033[0m\n' "$ROOT/${ATTACH#./}"
    echo
    echo "     They are staged there for you, named by what each one is FOR."
    echo "     Read MANIFEST.txt in that folder before the front view — the"
    echo "     approved front is the one image a front view must NOT be given."
elif [ -n "$ACTOR" ]; then
    echo "  3. Attach the actor photograph:"
    echo "$ACTOR" | sed "s|^|       $ROOT/|"
else
    warn "  3. No actor photograph in $DIR/reference/actor/ — the face will be generic."
fi
echo
echo "  4. Its reply MUST start with this line. No line, no image:"
echo
printf '       \033[1mWorking from commit %s, prompt %s.\033[0m\n' "$COMMIT" "$HASH"
echo
for c in "xclip -selection clipboard <" "xsel --clipboard <" "wl-copy <" "pbcopy <"; do
    if command -v "${c%% *}" >/dev/null 2>&1; then
        echo "  Copy it to the clipboard with:"
        printf '       \033[36m%s %s\033[0m\n' "$c" "$ROOT/${FRONT#./}"
        echo
        break
    fi
done
echo "  Full procedure: 09-prompt-library/Character-Image-Checklist.md"
echo
